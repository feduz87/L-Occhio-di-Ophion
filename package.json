{
  "name": "occhio-di-ophion",
  "version": "0.0.1",
  "description": "Omni-Engine RPG PWA - Strategic Turn-Based RPG with IA Narrative",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:init": "node server/db/init.js",
    "db:seed": "node server/db/seed.js",
    "db:reset": "node server/db/reset.js",
    "db:setup": "npm run db:init && npm run db:seed",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint server/ client/src/",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.1.2",
    "uuid": "^9.0.1",
    "pino": "^8.17.2",
    "axios": "^1.6.2"
  },
  "devDependencies": {
    "vitest": "^1.0.4",
    "prettier": "^3.1.1",
    "eslint": "^8.55.0",
    "@eslint/js": "^8.55.0",
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "rpg",
    "pwa",
    "game-engine",
    "turn-based",
    "ai-narrative"
  ],
  "license": "MIT"
}
